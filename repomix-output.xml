      // Live countdown timer
      function updateCountdown() {
        const electionDate = new Date("2025-07-24T07:00:00").getTime();
        const now = new Date().getTime();
        const timeLeft = electionDate - now;

        const hours = Math.floor(timeLeft / (1000 * 60 * 60));
        const countdownElement = document.getElementById("countdown-time");

        if (hours > 0) {
          countdownElement.textContent = hours;
        } else {
          countdownElement.textContent = "VOTE NOW!";
          countdownElement.style.fontSize = "48px";
          document.querySelector(".countdown-label").textContent =
            "Polling Stations Open";
        }
      }

      // Update countdown every hour
      updateCountdown();
      setInterval(updateCountdown, 3600000);

      // Intersection Observer for evidence items
      const observerOptions = {
        threshold: 0.1,
        rootMargin: "0px 0px -50px 0px",
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry, index) => {
          if (entry.isIntersecting) {
            setTimeout(() => {
              entry.target.classList.add("visible");
            }, index * 200);
          }
        });
      }, observerOptions);

      document.querySelectorAll(".evidence-item").forEach((el) => {
        observer.observe(el);
      });

      // Form handling
      document
        .getElementById("vote-commitment-form")
        .addEventListener("submit", function (e) {
          e.preventDefault();

          // Simple validation
          const checkbox = document.getElementById("vote-commitment");
          if (!checkbox.checked) {
            alert("Please confirm your commitment to vote for change.");
            return;
          }

          // Show confirmation
          document.getElementById("commitment-confirmation").style.display =
            "block";

          // Scroll to confirmation
          document.getElementById("commitment-confirmation").scrollIntoView({
            behavior: "smooth",
            block: "center",
          });

          // Reset form after delay
          setTimeout(() => {
            this.reset();
          }, 2000);
        });

      // Enable/disable submit button based on commitment checkbox
      document
        .getElementById("vote-commitment")
        .addEventListener("change", function () {
          const submitBtn = document.getElementById("submit-commitment");
          submitBtn.disabled = !this.checked;
        });

      function shareCountdown() {
        const text =
          "⏰ 48 HOURS LEFT! Swanage faces a choice: integrity or more corruption. Electoral violations, rigged consultations, emergency services ignored. Vote for change July 24th! #SwanageElection #DemocracyMatters";

        if (navigator.share) {
          navigator.share({
            title: "48 Hours to Save Swanage Democracy",
            text: text,
            url: window.location.href,
          });
        } else {
          window.open(
            "https://www.facebook.com/sharer/sharer.php?u=" +
              encodeURIComponent(window.location.href) +
              "&quote=" +
              encodeURIComponent(text),
            "_blank"
          );
        }
      }

      // Dynamic background animation speed based on urgency
      function adjustUrgency() {
        const hours = parseInt(
          document.getElementById("countdown-time").textContent
        );
        const bgElement = document.querySelector(".countdown-bg");

        if (hours < 24) {
          bgElement.style.animationDuration = "10s"; // Faster when urgent
        } else if (hours < 48) {
          bgElement.style.animationDuration = "15s";
        }
      }

      adjustUrgency();
      setInterval(adjustUrgency, 3600000);
    </script>


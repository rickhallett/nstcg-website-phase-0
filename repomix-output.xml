                  bar.classList.add("visible");
                }, index * 300);
              });
            }
          }
        });
      }, observerOptions);

      // Observe all animatable elements
      document.querySelectorAll(".data-viz, .timeline-card").forEach((el) => {
        observer.observe(el);
      });

      // Staggered animation for timeline cards
      const timelineCards = document.querySelectorAll(".timeline-card");
      const timelineObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry, index) => {
          if (entry.isIntersecting) {
            setTimeout(() => {
              entry.target.classList.add("visible");
            }, index * 150);
          }
        });
      }, observerOptions);

      timelineCards.forEach((card) => {
        timelineObserver.observe(card);
      });

      function exposeFraud() {
        const text =
          "EXPOSED: Swanage Council rigged their consultation! CAPTCHA barriers, missing surveys, excluded businesses - democracy under threat!";

        window.open(
          "https://www.facebook.com/sharer/sharer.php?u=" +
            encodeURIComponent(window.location.href) +
            "&quote=" +
            encodeURIComponent(text),
          "_blank"
        );
      }

      // Add some visual flair on scroll
      window.addEventListener("scroll", () => {
        const scrolled = window.pageYOffset;
        const manipulation = document.querySelector(".manipulation-badge");
        if (manipulation && scrolled < window.innerHeight) {
          manipulation.style.transform = `rotate(${-2 + scrolled * 0.01}deg)`;
        }
      });

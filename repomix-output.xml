  gap: 20px;
  margin: 30px 0;
}

.prize-tier {
  padding: 20px;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 8px;
  transition: all 0.3s ease;
}

.prize-tier.gold {
  border: 2px solid #ffd700;
}

.prize-tier.silver {
  border: 2px solid #c0c0c0;
}

.prize-tier.bronze {
  border: 2px solid #cd7f32;
}

.prize-tier:hover {
  transform: translateY(-5px);
  box-shadow: 0 5px 20px rgba(255, 215, 0, 0.2);
}

.prize-icon {
  font-size: 48px;
  margin-bottom: 10px;
}

.prize-label {
  font-size: 20px;
  font-weight: bold;
  color: #fff;
  margin-bottom: 5px;
}

.prize-tier.gold .prize-label {
  color: #ffd700;
}

.prize-tier.silver .prize-label {
  color: #c0c0c0;
}

.prize-tier.bronze .prize-label {
  color: #cd7f32;
}

.prize-desc {
  font-size: 14px;
  color: #999;
}

.prize-note {
  font-size: 14px;
  color: #999;
  font-style: italic;
  margin-top: 20px;
}

/* Mobile responsive for prize pool */
@media (max-width: 768px) {
  .prize-tiers {
    grid-template-columns: 1fr;
    gap: 15px;
  }
  
  .prize-pool-info {
    padding: 20px;
    margin: 30px 10px 0;
  }
  
  .prize-icon {
    font-size: 36px;
  }
  
  /* Stack hero stats vertically on mobile */
  .hero-stats {
    flex-direction: column;
    gap: 20px;
  }
}

/* Donation Form Section */
.donation-form-section {
  padding: 60px 0;
}

.donation-content {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: start;
}

/* Total Donations Card in Hero */
.hero-stats .total-donations-card {
  flex: 1;
  background: linear-gradient(135deg, #ffa500 0%, #ff8c00 100%);
  padding: 30px;
  border-radius: 10px;
  box-shadow: 0 4px 20px rgba(255, 165, 0, 0.3);
  border: 2px solid rgba(255, 215, 0, 0.5);
  text-align: center;
}

.hero-stats .total-donations-card h2 {
  color: #1a1a1a;
}

.hero-stats .counter-display {
  font-size: clamp(28px, 4vw, 36px);
  font-weight: bold;
  margin: 20px 0;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 5px;
}

.hero-stats .total-donations-card .counter-display {
  color: #1a1a1a;
}

.total-loading {
  padding: 20px;
}

.hero-stats .total-loading .loading-spinner {
  width: 40px;
  height: 40px;
  border: 3px solid rgba(26, 26, 26, 0.2);
  border-top-color: #1a1a1a;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto 15px;
}

.hero-stats .total-loading p {
  color: #1a1a1a;
  font-size: 14px;
}

.hero-stats .total-donations-card .currency {
  color: #1a1a1a;
}

.hero-stats .total-info p {
  font-size: 16px;
  margin-bottom: 20px;
  color: #1a1a1a;
  font-weight: 600;
}

.hero-stats .total-donations-card .amount {
  font-variant-numeric: tabular-nums;
}

.progress-to-goal {
  margin-top: 20px;
  padding-top: 20px;
  border-top: 1px solid rgba(26, 26, 26, 0.2);
}

.progress-bar {
  width: 100%;
  height: 20px;
  background: rgba(26, 26, 26, 0.2);
  border-radius: 10px;
  overflow: hidden;
  margin-bottom: 10px;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1a1a1a 0%, #333 100%);
  border-radius: 10px;
  width: 0%;
  transition: width 1s ease-out;
}

.progress-text {
  font-size: 14px;
  color: #1a1a1a;
  font-weight: 600;
}

.donation-card {
  background: #2a2a2a;
  padding: 40px;
  border-radius: 10px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  border: 1px solid rgba(0, 255, 0, 0.1);
}

.donation-card h2 {
  font-size: 28px;
  margin-bottom: 30px;
  color: #fff;
  text-align: center;
}

/* Amount Selector */
.amount-selector {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
  gap: 15px;
  margin-bottom: 30px;
}

.amount-btn {
  padding: 20px;
  background: #333;
  border: 2px solid #666;
  color: #fff;
  font-size: 20px;
  font-weight: bold;
  border-radius: 5px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.amount-btn:hover {
  background: #444;
  border-color: #00ff00;
  transform: translateY(-2px);
}

.amount-btn.active {
  background: #00ff00;
  color: #1a1a1a;
  border-color: #00ff00;
  transform: translateY(-2px);
}

.amount-btn.other {
  background: #444;
}

/* Custom Amount */
.custom-amount {
  margin-bottom: 30px;
}

.custom-amount label {
  display: block;
  margin-bottom: 10px;
  color: #ccc;
  font-weight: bold;
}

.custom-amount input {
  width: 100%;
  padding: 15px;
  background: rgba(255, 255, 255, 0.1);
  border: 2px solid #666;
  border-radius: 5px;
  color: #fff;
  font-size: 18px;
  transition: all 0.3s ease;
}

.custom-amount input:focus {
  outline: none;
  border-color: #00ff00;
  background: rgba(255, 255, 255, 0.15);
}

/* Form Groups */
.form-group {
  margin-bottom: 20px;
}

.form-group label {
  display: block;
  margin-bottom: 8px;
  font-weight: bold;
  color: #ccc;
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.form-group input,
.form-group textarea {
  width: 100%;
  padding: 15px;
  background: rgba(255, 255, 255, 0.1);
  border: 2px solid #666;
  border-radius: 5px;
  color: #fff;
  font-size: 16px;
  transition: all 0.3s ease;
}

.form-group input:focus,
.form-group textarea:focus {
  outline: none;
  border-color: #00ff00;
  background: rgba(255, 255, 255, 0.15);
}

.form-group textarea {
  resize: vertical;
  min-height: 80px;
}

/* Points Preview */
.points-preview {
  background: rgba(0, 255, 0, 0.1);
  padding: 20px;
  border-radius: 5px;
  margin-bottom: 20px;
  text-align: center;
  border: 1px solid rgba(0, 255, 0, 0.3);
}

.points-preview p {
  margin: 0;
  font-size: 16px;
}

.points-preview strong {
  color: #00ff00;
  font-size: 24px;
  margin: 0 5px;
}

/* Donate Button */
.donate-btn {
  width: 100%;
  padding: 20px;
  background: #00ff00;
  color: #1a1a1a;
  border: none;
  border-radius: 5px;
  font-size: 20px;
  font-weight: bold;
  cursor: pointer;
  transition: all 0.3s ease;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.donate-btn:hover:not(:disabled) {
  background: #00cc00;
  transform: translateY(-2px);
  box-shadow: 0 5px 20px rgba(0, 255, 0, 0.3);
}

.donate-btn:disabled {
  background: #666;
  color: #999;
  cursor: not-allowed;
  transform: none;
}

/* Recent Donations */
.recent-donations {
  background: #2a2a2a;
  padding: 40px;
  border-radius: 10px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  border: 1px solid rgba(0, 255, 0, 0.1);
}

.recent-donations h3 {
  font-size: 24px;
  margin-bottom: 30px;
  text-align: center;
  color: #fff;
}

#donations-feed {
  max-height: 600px;
  overflow-y: auto;
}

.donation-item {
  display: flex;
  align-items: flex-start;
  padding: 20px;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 8px;
  margin-bottom: 15px;
  transition: all 0.3s ease;
  border: 1px solid transparent;
}

.donation-item:hover {
  transform: translateX(5px);
  border-color: rgba(0, 255, 0, 0.3);
  background: rgba(0, 0, 0, 0.5);
}

.donation-amount {
  font-size: 24px;
  font-weight: bold;
  color: #00ff00;
  margin-right: 20px;
  min-width: 80px;
}

.donation-info {
  flex: 1;
}

.donation-name {
  font-weight: bold;
  margin-bottom: 5px;
  color: #fff;
}

.donation-message {
  font-style: italic;
  color: #ccc;
  margin-bottom: 5px;
  line-height: 1.4;
}

.donation-time {
  font-size: 14px;
  color: #666;
}

.no-donations {
  text-align: center;
  color: #666;
  padding: 40px;
  font-style: italic;
}

/* Loading States */
.donations-loading {
  text-align: center;
  padding: 40px;
  color: #666;
}

.loading-spinner {
  width: 40px;
  height: 40px;
  border: 3px solid rgba(0, 255, 0, 0.1);
  border-top-color: #00ff00;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto 20px;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* Success/Error Messages */
.donation-message {
  padding: 60px 0;
  text-align: center;
}

.success-message {
  background: rgba(0, 255, 0, 0.05);
}

.success-message h2 {
  color: #00ff00;
  font-size: 36px;
  margin-bottom: 20px;
}

.error-message {
  background: rgba(255, 0, 0, 0.05);
}

.error-message h2 {
  color: #ff6666;
  font-size: 36px;
  margin-bottom: 20px;
}

.donation-message p {
  font-size: 18px;
  color: #ccc;
  margin-bottom: 15px;
}

.donation-message a {
  color: #00ff00;
  text-decoration: underline;
}

.btn {
  display: inline-block;
  padding: 15px 30px;
  margin-top: 20px;
  background: #00ff00;
  color: #1a1a1a;
  text-decoration: none;
  border-radius: 5px;
  font-weight: bold;
  transition: all 0.3s ease;
  border: none;
  cursor: pointer;
}

.btn:hover {
  background: #00cc00;
  transform: translateY(-2px);
}

/* Form Error */
.form-error {
  background: rgba(255, 0, 0, 0.1);
  border: 1px solid #ff0000;
  color: #ff6666;
  padding: 15px;
  border-radius: 5px;
  margin-bottom: 20px;
  text-align: center;
  display: none;
}

/* Mobile Responsive */
@media (max-width: 1200px) {
  .donation-content {
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }
  
  .total-donations-card {
    grid-column: 1 / -1;
  }
}

@media (max-width: 968px) {
  .donation-content {
    grid-template-columns: 1fr;
    gap: 30px;
  }
}

@media (max-width: 768px) {
  .donate-hero {
    padding: 40px 0;
  }
  
  .donate-hero h1 {
    font-size: 32px;
  }
  
  .counter-display {
    font-size: 24px;
  }
  
  .donation-card {
    padding: 20px;
  }
  
  .amount-selector {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .donation-amount {
    font-size: 20px;
    min-width: 60px;
  }
}

/* Scrollbar Styling */
#donations-feed::-webkit-scrollbar {
  width: 8px;
}

#donations-feed::-webkit-scrollbar-track {
  background: rgba(0, 0, 0, 0.3);
  border-radius: 4px;
}

#donations-feed::-webkit-scrollbar-thumb {
  background: rgba(0, 255, 0, 0.3);
  border-radius: 4px;
}

#donations-feed::-webkit-scrollbar-thumb:hover {
  background: rgba(0, 255, 0, 0.5);
}

    <!-- Hero Section -->
    <section class="hero">
      <div class="container">
        <div class="hero-content">
          <h1 class="headline">The Road That Divided Swanage</h1>
          <p class="subheadline">
            How a single council decision threatens to reshape traffic patterns,
            destroy local businesses, and fracture a seaside community
          </p>
          <div class="byline">
            An Investigation by the North Swanage Traffic Concern Group •
            December 2024
          </div>

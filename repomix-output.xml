def extract_activation_link(html_body):
    """Extract activation link from email body"""
    import re
    pattern = r'https://nstcg\.org/\?user_email=([^&]+)&bonus=(\d+)'
    match = re.search(pattern, html_body)
    if match:
        return {
            'email': match.group(1),
            'bonus': int(match.group(2))
        }
    return None

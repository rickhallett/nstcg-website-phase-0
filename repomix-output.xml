<file path="css/pages/donate.css">
/* Donation Page Specific Styles */
.donate-page {
  min-height: 100vh;
  background: var(--bg-primary);
  color: var(--text-primary);
  padding-top: 60px; /* Account for navigation */
}

/* Hero Section */
.donate-hero {
  padding: 60px 0;
  text-align: center;
  background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);
  border-bottom: 1px solid rgba(0, 255, 0, 0.2);
}

.donate-hero h1 {
  font-size: clamp(36px, 5vw, 48px);
  font-weight: 900;
  margin-bottom: 20px;
  background: linear-gradient(135deg, #00ff00 0%, #00cc00 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  text-transform: uppercase;
  letter-spacing: 2px;
}

.donate-hero p {
  font-size: clamp(18px, 2.5vw, 24px);
  color: #ccc;
  max-width: 600px;
  margin: 0 auto;
}

/* Hero Stats Container */
.hero-stats {
  display: flex;
  gap: 30px;
  justify-content: center;
  align-items: stretch;
  margin-top: 40px;
  max-width: 1000px;
  margin-left: auto;
  margin-right: auto;
}

/* Cost Counter */
.cost-counter {
  flex: 1;
  padding: 30px;
  background: rgba(0, 255, 0, 0.05);
  border: 2px solid rgba(0, 255, 0, 0.3);
  border-radius: 10px;
  backdrop-filter: blur(10px);
}

.cost-counter h2,
.hero-stats .total-donations-card h2 {
  font-size: 20px;
  color: #00ff00;
  margin-bottom: 20px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.counter-display {
  font-size: clamp(28px, 4vw, 36px);
  font-weight: bold;
  margin: 20px 0;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 5px;
}

.counter-display .currency {
  color: #00ff00;
}

.counter-display .amount {
  color: #fff;
  font-variant-numeric: tabular-nums;
}

.counter-display .label {
  font-size: 18px;
  color: #999;
  font-weight: normal;
  margin-left: 10px;
}

.cost-breakdown {
  margin-top: 20px;
  font-size: 14px;
}

.cost-breakdown summary {
  cursor: pointer;
  color: #00ff00;
  text-decoration: underline;
  font-weight: bold;
}

.cost-breakdown summary:hover {
  color: #00cc00;
}

.cost-breakdown ul {
  list-style: none;
  margin-top: 15px;
  padding: 0;
  text-align: left;
}

.cost-breakdown li {
  padding: 8px 0;
  color: #ccc;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.cost-breakdown li:last-child {
  border-bottom: none;
}

/* Prize Pool Section */
.prize-pool-info {
  max-width: 800px;
  margin: 40px auto 0;
  padding: 30px;
  background: rgba(255, 215, 0, 0.05);
  border: 2px solid rgba(255, 215, 0, 0.3);
  border-radius: 10px;
  text-align: center;
}

.prize-pool-info h3 {
  font-size: 24px;
  color: #ffd700;
  margin-bottom: 20px;
  text-transform: uppercase;
  letter-spacing: 1px;

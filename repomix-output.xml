    gap: 20px;
  }
  
  .financial-item {
    padding: 15px;
  }
  
  .financial-icon {
    font-size: 30px;
  }
  
  .financial-content .amount {
    font-size: 24px;
  }
  
  .donate-button {
    padding: 12px 30px;
    font-size: 16px;
  }
}

<file path="css/components/forms.css">
/**
 * Forms Component
 * Form styles and input elements
 */

/* Ensure proper box sizing for all form elements */
form *,
form *::before,
form *::after {
  box-sizing: border-box;
}

.form-section {
  background: var(--bg-tertiary);
  border-radius: var(--radius-md);
  padding: 40px;
  margin: 30px 0;
  border: 3px solid var(--color-primary);
  position: relative;
}

.form-header {
  text-align: center;
  margin-bottom: 30px;
}

.form-title {
  font-size: 32px;
  font-weight: var(--font-weight-black);
  text-transform: uppercase;
  margin-bottom: 10px;
}

.form-subtitle {
  color: var(--color-primary);
  font-size: 20px;
  font-weight: var(--font-weight-bold);
}

.signup-form {
  max-width: 500px;
  margin: 0 auto;
}

.form-group {
  margin-bottom: 20px;
}

/* Horizontal form group for name fields */
.form-group-row {
  display: flex;
  gap: 15px;
  margin-bottom: 20px;
}

.form-group-row .form-group,
.form-group-row .modal-form-group {
  flex: 1;
  margin-bottom: 0;
}

input[type="text"],
input[type="email"],
textarea {
  width: 100%;
  padding: 15px;
  background: var(--bg-input);
  border: 2px solid var(--color-gray);
  border-radius: var(--radius-sm);
  color: var(--color-white);
  font-size: 16px;
  transition: all var(--transition-base);
  font-family: inherit;
  box-sizing: border-box;
}

input[type="text"]:focus,
input[type="email"]:focus,
textarea:focus {
  outline: none;
  border-color: var(--color-primary);
  background: var(--bg-input-focus);
  box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.2);
}

/* Error state styling */
input[type="text"].error,
input[type="email"].error,
textarea.error {
  border-color: #ff0000;
  background: rgba(255, 0, 0, 0.1);
  box-shadow: 0 0 0 3px rgba(255, 0, 0, 0.2);
}

input[type="text"].error::placeholder,
input[type="email"].error::placeholder,
textarea.error::placeholder {
  color: #ff6666;
  opacity: 1;
}

input[type="text"].error:focus,
input[type="email"].error:focus,
textarea.error:focus {
  border-color: #ff0000;
  background: rgba(255, 0, 0, 0.15);
  box-shadow: 0 0 0 3px rgba(255, 0, 0, 0.3);
}

textarea::placeholder {
  color: var(--color-gray-light);
  opacity: 0.8;
}

.submit-btn {
  width: 100%;
  padding: 20px;
  background: var(--color-primary);
  color: var(--color-white);
  border: none;
  border-radius: var(--radius-sm);
  font-size: 20px;
  font-weight: var(--font-weight-black);
  text-transform: uppercase;
  letter-spacing: 2px;
  cursor: pointer;
  transition: all var(--transition-base);
  position: relative;
  overflow: hidden;
}

.submit-btn:hover {
  background: var(--color-primary-dark);
  transform: translateY(-2px);
  box-shadow: 0 5px 20px rgba(52, 152, 219, 0.5);
}

.submit-btn:active {
  transform: translateY(0);
}

/* Radio Button Styles */
.radio-group {
  border: none;
  padding: 0;
  margin: 0;
}

.radio-group legend {
  display: block;
  margin-bottom: 12px;
  color: var(--color-white);
  font-size: 16px;
  font-weight: var(--font-weight-medium);
}

.radio-options {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
}

.radio-label {
  display: flex;
  align-items: center;
  cursor: pointer;
  color: var(--color-white);
  font-size: 16px;
  position: relative;
  transition: all var(--transition-base);
}

.radio-label:hover {
  color: var(--color-primary);
}

.radio-label input[type="radio"] {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.radio-custom {
  width: 20px;
  height: 20px;
  border: 2px solid var(--color-gray);
  border-radius: 50%;
  margin-right: 10px;
  position: relative;
  transition: all var(--transition-base);
}

.radio-custom::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0);
  width: 10px;
  height: 10px;
  background: var(--color-primary);
  border-radius: 50%;
  transition: transform var(--transition-base);
}

.radio-label input[type="radio"]:checked ~ .radio-custom {
  border-color: var(--color-primary);
}

.radio-label input[type="radio"]:checked ~ .radio-custom::after {
  transform: translate(-50%, -50%) scale(1);
}

.radio-label input[type="radio"]:focus ~ .radio-custom {
  box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.2);
}

/* Error state for radio buttons */
.radio-group.error .radio-custom {
  border-color: #ff0000;
}

.radio-group.error legend {
  color: #ff6666;
}

/* Modal specific radio styles */
.modal-form-group .radio-group {
  margin-top: 10px;
}

.modal-form-group .radio-options {
  gap: 15px;
}

/* Mobile adjustments */
@media (max-width: 768px) {
  .form-section {
    padding: 25px;
  }

  .form-section h2 {
    font-size: 24px;
  }

  /* Stack name fields on mobile */
  .form-group-row {
    flex-direction: column;
    gap: 0;
  }
  
  .form-group-row .form-group,
  .form-group-row .modal-form-group {
    margin-bottom: 20px;
  }
  
  .form-group-row .form-group:last-child,
  .form-group-row .modal-form-group:last-child {
    margin-bottom: 0;
  }

  /* Stack radio buttons on mobile */
  .radio-options {
    flex-direction: column;
    gap: 12px;
  }

  .radio-label {
    font-size: 15px;
  }
}

/* Referral Bonus Notice */
.referred-visitor .referral-bonus-notice {
  display: block !important;
  color: #00ff00;
  font-weight: bold;
  text-align: center;
  margin-bottom: 15px;
  font-size: 18px;
  padding: 10px;
  background: rgba(0, 255, 0, 0.1);
  border: 2px solid #00ff00;
  border-radius: 5px;
}

@keyframes blink {
  0%, 50% { opacity: 1; }
  51%, 100% { opacity: 0.3; }
}

.blinking-text {
  animation: blink 1s infinite;
  display: inline-block;
}
